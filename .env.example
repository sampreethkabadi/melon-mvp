# Copy to .env.local for local development. On Vercel, add these under Settings > Environment Variables.

# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" / "publishable" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. Server only. Never share or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Students sign in with these email domains (comma-separated). Also set in the schools table.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=iu.edu

# Test data: open /api/dev/seed?secret=SEED_SECRET once after deploying.
SEED_SECRET=make-up-a-long-random-string
# Password for all @melon.test test accounts (10+ characters).
SEED_PASSWORD=

# Optional. Without these the demo still works, using the sample conversation and saved suggestions.
# Claude drafts session suggestions: https://platform.claude.com
ANTHROPIC_API_KEY=
# Deepgram turns recordings into transcripts: https://console.deepgram.com
DEEPGRAM_API_KEY=
